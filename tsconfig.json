{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "src/**/*.ts", "src/**/*.d.ts", "scripts/**/*.ts"],
  "exclude": ["dist", "node_modules", "src/content.config.ts"]
}
