{
  "name": "ladestack-blog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight, original, multilingual static editorial publication built with Astro",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 3000",
    "build:site": "astro build",
    "build:search": "node --import tsx scripts/build-search-index.ts",
    "build": "npm run validate:content && npm run build:site && npm run build:search",
    "preview": "astro preview --host 0.0.0.0 --port 3000",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "verify:seo": "node --import tsx scripts/verify-seo.ts",
    "verify:output": "node --import tsx scripts/audit-output.ts",
    "verify:links": "node --import tsx scripts/audit-links.ts",
    "check": "npm run lint && npm run verify:seo",
    "lint": "node --import tsx scripts/validate-content.ts && astro check && tsc --noEmit",
    "test": "node --import tsx --test src/lib/blog.test.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^5.3.0",
    "marked": "^15.0.7",
    "pagefind": "^1.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
