---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { LOCALE_REGISTRY, type Locale } from '../data/locales';
import { SITE_CONFIG } from '../data/site';
import { getDictionary } from '../i18n';
import { buildCanonicalUrl } from '../i18n/urls';
import { resolveSocialImageUrl, type HreflangAlternate } from '../lib/seo';
import type { LocaleSwitchOption } from '../lib/translations';
import SiteHeader from '../components/shell/SiteHeader.astro';
import SearchDialog from '../components/shell/SearchDialog.astro';
import SiteFooter from '../components/shell/SiteFooter.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  alternates?: HreflangAlternate[];
  localeOptions: LocaleSwitchOption[];
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  articleSection?: string;
  articleTags?: string[];
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const {
  locale,
  title,
  description,
  canonicalPath,
  alternates = [],
  localeOptions,
  ogType = 'website',
  ogImage = SITE_CONFIG.defaultOgImage,
  ogImageAlt,
  articleSection,
  articleTags = [],
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const dict = getDictionary(locale);
const htmlLang = LOCALE_REGISTRY[locale].htmlLang;
const canonicalUrl = buildCanonicalUrl(canonicalPath);
const absoluteOgImage = resolveSocialImageUrl(ogImage);
const fullTitle = title.includes(SITE_CONFIG.name)
  ? title
  : `${title} — ${SITE_CONFIG.name}`;
const resolvedImageAlt = ogImageAlt || fullTitle;
const safeAlternates = noindex ? [] : alternates;
const ogAlternateLocales = safeAlternates
  .filter((alt) => alt.hreflang !== 'x-default' && alt.hreflang !== locale)
  .map((alt) => LOCALE_REGISTRY[alt.hreflang as Locale].dateLocale.replace('-', '_'));
---

<!doctype html>
<html lang={htmlLang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="LadeStack Blog RSS" href="/rss.xml" />

    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      safeAlternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }

    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:alt" content={resolvedImageAlt} />
    <meta property="og:image:width" content={String(SITE_CONFIG.defaultOgImageWidth)} />
    <meta property="og:image:height" content={String(SITE_CONFIG.defaultOgImageHeight)} />
    <meta property="og:locale" content={LOCALE_REGISTRY[locale].dateLocale.replace('-', '_')} />
    {
      ogAlternateLocales.map((altLoc) => (
        <meta property="og:locale:alternate" content={altLoc} />
      ))
    }

    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && articleSection && <meta property="article:section" content={articleSection} />}
    {
      ogType === 'article' &&
        articleTags.map((tag) => <meta property="article:tag" content={tag} />)
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={resolvedImageAlt} />

    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('ladestack-theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          } else {
            document.documentElement.removeAttribute('data-theme');
          }
        } catch (e) {}
      })();
    </script>

    {
      jsonLd.map((schema) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      ))
    }
  </head>
  <body>
    <a href="#main-content" class="skip-link">{dict.skipToContent}</a>

    <SiteHeader
      locale={locale}
      localeOptions={localeOptions}
      currentPath={canonicalPath}
    />

    <main id="main-content">
      <slot />
    </main>

    <SearchDialog locale={locale} />
    <SiteFooter locale={locale} />

    <script is:inline>
      (function () {
        // 1. Theme Switcher (System -> Light -> Dark)
        var themeBtn = document.querySelector('[data-theme-toggle]');
        var themeText = document.querySelector('[data-theme-text]');
        var modes = ['system', 'light', 'dark'];

        function getStoredTheme() {
          try {
            var val = localStorage.getItem('ladestack-theme');
            return val === 'light' || val === 'dark' ? val : 'system';
          } catch (e) {
            return 'system';
          }
        }

        function updateThemeUI(mode) {
          if (!themeBtn || !themeText) return;
          var label =
            mode === 'light'
              ? themeBtn.getAttribute('data-label-light')
              : mode === 'dark'
              ? themeBtn.getAttribute('data-label-dark')
              : themeBtn.getAttribute('data-label-system');
          themeText.textContent = label || mode;
          themeBtn.setAttribute('aria-label', 'Appearance: ' + (label || mode));
          if (mode === 'light' || mode === 'dark') {
            document.documentElement.setAttribute('data-theme', mode);
          } else {
            document.documentElement.removeAttribute('data-theme');
          }
        }

        updateThemeUI(getStoredTheme());

        if (themeBtn) {
          themeBtn.addEventListener('click', function () {
            var current = getStoredTheme();
            var next = modes[(modes.indexOf(current) + 1) % modes.length];
            try {
              if (next === 'system') {
                localStorage.removeItem('ladestack-theme');
              } else {
                localStorage.setItem('ladestack-theme', next);
              }
            } catch (e) {}
            updateThemeUI(next);
          });
        }

        // 2. Close Header Dropdowns on outside click or Escape
        document.addEventListener('click', function (e) {
          document.querySelectorAll('details[data-nav-dropdown][open]').forEach(function (el) {
            if (!el.contains(e.target)) {
              el.removeAttribute('open');
            }
          });
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            document.querySelectorAll('details[data-nav-dropdown][open]').forEach(function (el) {
              el.removeAttribute('open');
            });
          }
        });

        // 3. Universal Search Dialog (Lazy-loads official /pagefind/pagefind.js on open)
        var dialog = document.getElementById('site-search-dialog');
        var openBtns = document.querySelectorAll('[data-open-search]');
        var closeBtn = document.querySelector('[data-close-search]');
        var searchInput = document.querySelector('[data-search-input]');
        var categorySelect = document.querySelector('[data-search-category]');
        var statusEl = document.querySelector('[data-search-status]');
        var resultsEl = document.querySelector('[data-search-results]');
        var pagefindInstance = null;
        var debounceTimer = null;

        async function ensurePagefind() {
          if (!pagefindInstance) {
            var pf = await import('/pagefind/pagefind.js');
            if (typeof pf.init === 'function') {
              await pf.init();
            }
            pagefindInstance = pf;
          }
          return pagefindInstance;
        }

        function escapeHtml(str) {
          return String(str || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
        }

        async function executeSearch() {
          if (!dialog || !searchInput || !resultsEl || !statusEl) return;
          var q = searchInput.value.trim();
          var cat = categorySelect ? categorySelect.value : '';
          var noResultsText = dialog.getAttribute('data-no-results') || 'No matches.';
          var idlePrompt = dialog.getAttribute('data-idle-prompt') || 'Type a keyword to search.';
          var matchesLabel = dialog.getAttribute('data-matches-label') || 'matches';

          try {
            var pf = await ensurePagefind();
            var searchTerm = q ? q : null;
            var searchOpts = {};
            if (cat) {
              searchOpts.filters = { category: [cat] };
            }

            if (!searchTerm && !cat) {
              statusEl.textContent = idlePrompt;
              resultsEl.innerHTML = '';
              return;
            }

            var response = await pf.search(searchTerm, searchOpts);
            var rawResults = (response && response.results) ? response.results : [];
            statusEl.textContent = rawResults.length + ' ' + matchesLabel;

            if (rawResults.length === 0) {
              resultsEl.innerHTML =
                '<div class="empty-state-box"><p style="margin:0;">' +
                escapeHtml(noResultsText) +
                '</p></div>';
              return;
            }

            var topItems = await Promise.all(
              rawResults.slice(0, 12).map(function (r) {
                return r.data();
              })
            );

            resultsEl.innerHTML = topItems
              .map(function (item) {
                var meta = item.meta || {};
                var subResults = Array.isArray(item.sub_results)
                  ? item.sub_results.filter(function (s) {
                      return s.url !== item.url;
                    }).slice(0, 3)
                  : [];

                var subHtml = '';
                if (subResults.length > 0) {
                  subHtml =
                    '<div class="search-subresults">' +
                    subResults
                      .map(function (sec) {
                        return (
                          '<a class="search-subresult-link" href="' +
                          escapeHtml(sec.url) +
                          '">§ ' +
                          escapeHtml(sec.title) +
                          '</a>'
                        );
                      })
                      .join('') +
                    '</div>';
                }

                var metaLine = '';
                if (meta.categoryLabel || meta.publishedDate) {
                  metaLine =
                    '<div class="metadata-line" style="margin-bottom:4px;">' +
                    (meta.categoryLabel
                      ? '<span class="metadata-category-link">' + escapeHtml(meta.categoryLabel) + '</span>'
                      : '') +
                    (meta.categoryLabel && meta.publishedDate
                      ? '<span class="metadata-sep">·</span>'
                      : '') +
                    (meta.publishedDate
                      ? '<span>' + escapeHtml(meta.publishedDate) + '</span>'
                      : '') +
                    '</div>';
                }

                return (
                  '<div class="search-result-item">' +
                  metaLine +
                  '<h3 class="search-result-title"><a href="' +
                  escapeHtml(item.url) +
                  '">' +
                  escapeHtml(meta.title || item.url) +
                  '</a></h3>' +
                  '<p style="margin:0; font-size:0.875rem; color:var(--text-muted);">' +
                  (item.excerpt || escapeHtml(meta.description || '')) +
                  '</p>' +
                  subHtml +
                  '</div>'
                );
              })
              .join('');
          } catch (err) {
            statusEl.textContent = 'Search index unavailable.';
          }
        }

        function scheduleSearch() {
          if (debounceTimer) clearTimeout(debounceTimer);
          debounceTimer = setTimeout(executeSearch, 180);
        }

        function openSearchDialog() {
          if (!dialog) return;
          if (typeof dialog.showModal === 'function' && !dialog.open) {
            dialog.showModal();
          } else {
            dialog.setAttribute('open', 'true');
          }
          ensurePagefind().then(function () {
            if (
              (searchInput && searchInput.value.trim()) ||
              (categorySelect && categorySelect.value)
            ) {
              executeSearch();
            }
          });
          if (searchInput) searchInput.focus();
        }

        openBtns.forEach(function (btn) {
          btn.addEventListener('click', openSearchDialog);
        });

        if (closeBtn && dialog) {
          closeBtn.addEventListener('click', function () {
            dialog.close();
          });
        }

        if (dialog) {
          dialog.addEventListener('click', function (e) {
            if (e.target === dialog) dialog.close();
          });
        }

        if (searchInput) {
          searchInput.addEventListener('input', scheduleSearch);
        }
        if (categorySelect) {
          categorySelect.addEventListener('change', executeSearch);
        }

        document.addEventListener('keydown', function (e) {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            openSearchDialog();
          }
        });
      })();
    </script>
  </body>
</html>
