---
import { SITE_CONFIG } from '../../../data/site';
import { getPublishedPosts } from '../../../lib/posts';
import ArticlesArchiveView from '../../../components/views/ArticlesArchiveView.astro';

export function getStaticPaths() {
  const posts = getPublishedPosts('en');
  const totalPages = Math.ceil(posts.length / SITE_CONFIG.postsPerPage);
  const paths: { params: { page: string }; props: { page: number } }[] = [];

  for (let p = 2; p <= totalPages; p++) {
    paths.push({
      params: { page: String(p) },
      props: { page: p },
    });
  }

  return paths;
}

interface Props {
  page: number;
}

const { page } = Astro.props;
---

<ArticlesArchiveView locale="en" page={page} />
